{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".indexOn": ["meta/lastActive"],
      ".read": "query.orderByChild === 'meta/lastActive' && query.endAt <= now - 10800000 && query.limitToFirst <= 50",
      "$code": {
        ".read": true,
        ".write": true,
        "players": {
          "$pid": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "character": {
              "name": { ".validate": "newData.isString() && newData.val().length <= 40" }
            }
          }
        },
        "submissions": {
          "$pid": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" }
          }
        }
      }
    }
  }
}
